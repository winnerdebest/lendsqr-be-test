# Server
NODE_ENV=development
PORT=3000
SERVICE_NAME=lendsqr-wallet-service

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lendsqr_wallet

# Security & Authentication
JWT_SECRET=lendsqr-super-secret-jwt-key-change-in-production-2026
JWT_EXPIRES_IN=24h
ADMIN_API_KEY=lendsqr-admin-secret-key-2026
BCRYPT_SALT_ROUNDS=10

# Lendsqr Adjutor Karma Blacklist API (Scope: Karma Lookup)
# Leave blank to use local blacklist table only; provide key to query live Adjutor Karma API
ADJUTOR_BASE_URL=https://adjutor.lendsqr.com/v2
ADJUTOR_API_KEY=
KARMA_FAIL_CLOSED=false

# Paystack Funding Integration (Test Mode: sk_test_...)
# Leave blank to allow automatic simulated funding in development/review
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=https://winner-orluvictor-lendsqr-be-test.onrender.com/v1/wallets/fund/verify

# Transaction Limits (in kobo — e.g. 100 = ₦1.00, 1000000000 = ₦10,000,000.00)
MIN_TRANSACTION_AMOUNT_KOBO=10000
MAX_TRANSACTION_AMOUNT_KOBO=1000000000
IDEMPOTENCY_TTL_HOURS=24
