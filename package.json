{
  "name": "lendsqr-be-test",
  "version": "1.0.0",
  "description": "Lendsqr Full-Stack / DevOps Engineer Assessment — Production Wallet & Ledger Service",
  "main": "dist/server.js",
  "scripts": {
    "build:server": "tsc -p tsconfig.build.json",
    "build:client": "vite build --config vite.config.ts",
    "build": "npm run build:server && npm run build:client",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:client": "vite --config vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p client/tsconfig.json --noEmit",
    "migrate:latest": "tsx src/db/cli.ts latest",
    "migrate:rollback": "tsx src/db/cli.ts rollback",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit --runInBand",
    "test:integration": "jest tests/integration --runInBand",
    "test:coverage": "jest --coverage --runInBand"
  },
  "keywords": [
    "lendsqr",
    "wallet",
    "fintech",
    "double-entry-ledger",
    "typescript",
    "express",
    "react",
    "postgresql",
    "knex"
  ],
  "author": "Winner OrluVictor <winnerbrown9@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "pg": "^8.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jest": "^29.7.0",
    "pg-mem": "^3.0.5",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
